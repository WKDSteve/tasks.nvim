#!/bin/sh
# bin/tasks -- the `tasks` command for POSIX shells (Git Bash, Linux, macOS): put this folder on the PATH.
#
#   tasks <command> [options]   =   nvim -n -i NONE --headless -u NONE -l scripts/tasks.lua ...
#
# Runs in the caller's working directory and hands the exit code through (0 ok, 1 failure, 2 usage). Never silent:
# a missing nvim or an exit code above 2 (a crash) is named on stderr.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd) || exit 3
if [ ! -f "$here/../scripts/tasks.lua" ]; then
  # a copy or a symlink of this file elsewhere: put the checkout's bin/ folder on the PATH instead
  echo "tasks: cannot find $here/../scripts/tasks.lua: run bin/tasks of a tasks.nvim checkout" >&2
  exit 3
fi
if ! command -v nvim >/dev/null 2>&1; then
  echo "tasks: nvim is not on the PATH: nothing ran" >&2
  exit 3
fi
nvim -n -i NONE --headless -u NONE -l "$here/../scripts/tasks.lua" "$@"
rc=$?
case $rc in
0 | 1 | 2) ;;
*) echo "tasks: nvim ended with exit code $rc and no verdict (crash?)" >&2 ;;
esac
exit "$rc"
